{
  "schemaVersion": 1,
  "id": "mc-storage",
  "version": "${version}",
  "name": "MC Storage",
  "description": "将文件用方块保存到地图中",
  "authors": [
    "XUANXU"
  ],
  "contact": {
    "homepage": "https://fabricmc.net/",
    "sources": "https://github.com/XUANXUQAQ/mc-file-storage"
  },
  "license": "CC0-1.0",
  "icon": "assets/mc/storage/icon.png",
  "environment": "client",
  "entrypoints": {
    "main": [
      "github.mc.storage.StorageMod"
    ],
    "client": [
      "github.mc.storage.StorageModClient"
    ]
  },
  "mixins": [
    "modid.mixins.json",
    {
      "config": "modid.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.18.2",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  },
  "suggests": {
    "another-mod": "*"
  }
}